# PostgreSQL (obligatoire)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/afro_food?schema=public"

# Serveur
PORT=5000
NODE_ENV=development
JWT_SECRET="changez-moi-par-une-chaine-secrete-longue"
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000
BCRYPT_SALT_ROUNDS=12

# Rate limit
RATE_LIMIT_MAX_REQUESTS=1000
RATE_LIMIT_WINDOW_MS=900000

# Seed admin (optionnel)
ADMIN_SEED_EMAIL=admin@afrofood.com
ADMIN_SEED_PASSWORD=Admin123!

# E-mail (optionnel — sans SMTP, log en développement)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=identifiant-smtp-brevo (affiché dans Brevo, souvent xxxx@smtp-brevo.com)
# SMTP_PASS=clé-SMTP-brevo (pas le mot de passe du compte)
# EMAIL_FROM="Afro-food <adresse-verifiee-dans-brevo@exemple.com>"

# Dev sans DB (déconseillé)
# SKIP_DB_CONNECTION=false

# Paiement en ligne Stripe (optionnel — sans clé, le paiement par carte reste « à confirmer »)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_CURRENCY=eur

# Notifications push (générer avec : npx web-push generate-vapid-keys)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:contact@exemple.com

# Adresse qui reçoit les e-mails « nouvelle commande » (sinon : e-mail des comptes admin)
# ADMIN_NOTIFICATION_EMAIL=
