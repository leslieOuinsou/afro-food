// Afro-Food — schéma PostgreSQL via Prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  client
  admin
  livreur
}

enum RegimeAlimentaire {
  aucun
  vegetarien
  vegan
  halal
  kasher
}

enum NiveauEpice {
  doux
  moyen
  epicee
  tres_epicee @map("tres-epicee")
}

enum CategoriePlat {
  entrees
  plats_principaux       @map("plats-principaux")
  accompagnements
  desserts
  boissons
  specialites_africaines @map("specialites-africaines")
  vegetarien
  vegan
}

enum PaysOrigine {
  cameroun
  benin
  senegal
  cote_ivoire  @map("cote-ivoire")
  mali
  burkina_faso @map("burkina-faso")
  ghana
  togo
  niger
  guinee
  multiple
}

enum StatutCommande {
  en_attente
  confirmee
  en_preparation
  prete
  en_livraison
  livree
  annulee
  remboursee
}

enum MethodePaiement {
  carte
  especes
  mobile
  virement
}

enum StatutPaiement {
  en_attente
  valide
  echec
  rembourse
}

enum TypeLivraison {
  domicile
  point_relais
  retrait_sur_place
}

enum StatutAvis {
  en_attente
  approuve
  rejete
  signale
}

enum StatutMessage {
  non_lu
  lu
  repondu
}

model User {
  id                     String    @id @default(cuid())
  nom                    String
  prenom                 String
  email                  String    @unique
  telephone              String    @unique
  motDePasse             String
  role                   Role      @default(client)
  preferences            Json      @default("{\"allergies\":[],\"regimeAlimentaire\":\"aucun\",\"niveauEpice\":\"moyen\"}")
  estActif               Boolean   @default(true)
  emailVerifie           Boolean   @default(false)
  telephoneVerifie       Boolean   @default(false)
  tokenVerificationEmail String?
  expirationTokenEmail   DateTime?
  tokenResetMotDePasse   String?
  expirationTokenReset   DateTime?
  nombreCommandes        Int       @default(0)
  montantTotalCommandes  Float     @default(0)
  derniereConnexion      DateTime?
  avatar                 String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  adresses          Adresse[]
  commandes         Commande[]           @relation("ClientCommandes")
  livraisons        Commande[]           @relation("LivreurCommandes")
  reversementsRecus ReversementEspeces[] @relation("ReversementsLivreur")
  reversementsFaits ReversementEspeces[] @relation("ReversementsAdmin")
  journalLivreur    JournalCaisse[]      @relation("JournalLivreur")
  journalAuteur     JournalCaisse[]      @relation("JournalAuteur")
  pointages         PointageLivreur[]    @relation("PointagesLivreur")
  paiesRecues       PaieLivreur[]        @relation("PaiesLivreur")
  paiesFaites       PaieLivreur[]        @relation("PaiesAdmin")
  fichesRecues      FichePaie[]          @relation("FichesLivreur")
  fichesEmises      FichePaie[]          @relation("FichesAdmin")
  pointsFidelite    Int                  @default(0)
  mouvementsPoints  MouvementPoints[]
  avis              Avis[]
  platsCrees        Plat[]               @relation("PlatAdmin")
  votesAvis         AvisVote[]
  signalementsAvis  AvisSignalement[]
  historiqueStatuts HistoriqueStatut[]
  reponsesAvis      Avis[]               @relation("ReponseAvisAuteur")
  favoris           Favori[]
  pushSubscriptions PushSubscription[]
  /// Code unique de parrainage (ex. AFRO-AB12CD)
  codeParrain       String?              @unique
  /// Qui a parrainé ce compte (null = organique)
  parraineParId     String?
  parrainePar       User?                @relation("Parrainage", fields: [parraineParId], references: [id], onDelete: SetNull)
  filleuls          User[]               @relation("Parrainage")
  googleId          String?              @unique
  paniersGroupeHote PanierGroupe[]       @relation("GroupeHote")
  messagesChat      MessageChat[]
  abonnements       Abonnement[]

  @@index([role])
  @@index([parraineParId])
  @@map("users")
}

model Adresse {
  id         String  @id @default(cuid())
  type       String  @default("domicile")
  nom        String
  adresse    String
  ville      String
  codePostal String
  pays       String  @default("France")
  parDefaut  Boolean @default(false)
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("adresses")
}

model Plat {
  id                   String    @id @default(cuid())
  nom                  String
  description          String
  descriptionLongue    String?
  prix                 Float
  prixPromo            Float?
  categorie            String
  sousCategorie        String?
  origineAfricaine     Json
  images               Json
  nutrition            Json?
  allergenes           String[]  @default([])
  regimesCompatibles   String[]  @default([])
  niveauEpice          String    @default("moyen")
  ingredients          Json      @default("[]")
  tempsPreparation     Int?
  disponible           Boolean   @default(true)
  enRupture            Boolean   @default(false)
  quantiteDisponible   Int?
  notemoyenne          Float     @default(0)
  nombreAvis           Int       @default(0)
  nombreCommandes      Int       @default(0)
  tags                 String[]  @default([])
  slug                 String    @unique
  metaDescription      String?
  creeParAdminId       String?
  creeParAdmin         User?     @relation("PlatAdmin", fields: [creeParAdminId], references: [id], onDelete: SetNull)
  derniereModification DateTime  @default(now())
  estMisEnAvant        Boolean   @default(false)
  estNouveaute         Boolean   @default(false)
  dateFinNouveaute     DateTime?
  variations           Json      @default("[]")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  articles ArticleCommande[]
  avis     Avis[]
  favoris  Favori[]

  @@index([categorie])
  @@index([disponible, enRupture])
  @@index([nombreCommandes])
  @@index([notemoyenne])
  @@index([nom])
  @@map("plats")
}

model Commande {
  id                 String         @id @default(cuid())
  numeroCommande     String         @unique
  clientId           String
  client             User           @relation("ClientCommandes", fields: [clientId], references: [id])
  informationsClient Json
  adresseLivraison   Json
  montants           Json
  statut             StatutCommande @default(en_attente)

  // Colonnes typées (requêtes SQL / statistiques). Les Json montants/paiement restent pour l'API.
  sousTotal         Float           @default(0)
  fraisLivraison    Float           @default(0)
  taxes             Float           @default(0)
  remise            Float           @default(0)
  total             Float           @default(0)
  codePromo         String?
  methodePaiement   MethodePaiement @default(carte)
  statutPaiement    StatutPaiement  @default(en_attente)
  paiementReference String?

  promoCodeId String?
  promoCode   PromoCode? @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)

  paiement      Json
  livraison     Json
  dates         Json
  preferences   Json?
  evaluation    Json?
  serviceClient Json?
  source        String   @default("web")
  deviceInfo    Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // livreur optionnel (dénormalisé aussi dans livraison Json)
  livreurId String?
  livreur   User?   @relation("LivreurCommandes", fields: [livreurId], references: [id], onDelete: SetNull)

  articles          ArticleCommande[]
  historiqueStatuts HistoriqueStatut[]
  avis              Avis[]

  // Facture (numérotation continue, attribuée une seule fois à la première émission)
  numeroFacture    String?   @unique
  factureLe        DateTime?
  // Commande programmée : créneau de livraison choisi par le client (null = dès que possible)
  creneauLivraison DateTime?
  // Fidélité : points créditionnés à la livraison (une seule fois par commande)
  pointsGagnes     Int       @default(0)

  // Paiement en espèces : preuve de remise et suivi du reversement à l'admin
  codeRemise           String?
  especesEncaissees    Float?
  especesEcartRaison   String?
  especesStatut        EspecesStatut?
  especesEncaisseLe    DateTime?
  reversementId        String?
  reversement          ReversementEspeces?    @relation(fields: [reversementId], references: [id], onDelete: SetNull)
  journalCaisse        JournalCaisse[]
  JustificatifVirement JustificatifVirement[]

  @@index([especesStatut, livreurId])
  @@index([clientId, createdAt])
  @@index([statut])
  @@index([createdAt])
  @@index([statutPaiement])
  @@index([livreurId])
  @@map("commandes")
}

model ArticleCommande {
  id               String   @id @default(cuid())
  commandeId       String
  commande         Commande @relation(fields: [commandeId], references: [id], onDelete: Cascade)
  platId           String
  plat             Plat     @relation(fields: [platId], references: [id])
  informationsPlat Json
  quantite         Int
  prixUnitaire     Float
  variations       Json     @default("[]")
  instructions     String?
  sousTotal        Float

  @@index([commandeId])
  @@index([platId])
  @@map("articles_commande")
}

model HistoriqueStatut {
  id             String         @id @default(cuid())
  commandeId     String
  commande       Commande       @relation(fields: [commandeId], references: [id], onDelete: Cascade)
  statut         StatutCommande
  dateChangement DateTime       @default(now())
  commentaire    String?
  modifieParId   String?
  modifiePar     User?          @relation(fields: [modifieParId], references: [id], onDelete: SetNull)

  @@index([commandeId])
  @@map("historique_statuts")
}

model Avis {
  id              String     @id @default(cuid())
  platId          String
  plat            Plat       @relation(fields: [platId], references: [id], onDelete: Cascade)
  utilisateurId   String
  utilisateur     User       @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  commandeId      String
  commande        Commande   @relation(fields: [commandeId], references: [id], onDelete: Cascade)
  note            Int
  titre           String?
  commentaire     String
  evaluations     Json?
  recommande      Boolean
  photos          Json       @default("[]")
  tags            String[]   @default([])
  statut          StatutAvis @default(en_attente)
  dateApprobation DateTime?
  modereParId     String?
  raisonRejet     String?
  utile           Int        @default(0)
  pasUtile        Int        @default(0)
  reponseContenu  String?
  reponseDate     DateTime?
  reponseAuteurId String?
  reponseAuteur   User?      @relation("ReponseAvisAuteur", fields: [reponseAuteurId], references: [id], onDelete: SetNull)
  langue          String     @default("fr")
  adresseIP       String?
  userAgent       String?
  achatVerifie    Boolean    @default(false)
  dateAchat       DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  votants      AvisVote[]
  signalements AvisSignalement[]

  @@unique([utilisateurId, commandeId, platId])
  @@index([platId, createdAt])
  @@index([utilisateurId])
  @@index([statut])
  @@map("avis")
}

model AvisVote {
  id            String   @id @default(cuid())
  avisId        String
  avis          Avis     @relation(fields: [avisId], references: [id], onDelete: Cascade)
  utilisateurId String
  utilisateur   User     @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  vote          String
  dateVote      DateTime @default(now())

  @@unique([avisId, utilisateurId])
  @@map("avis_votes")
}

model AvisSignalement {
  id              String   @id @default(cuid())
  avisId          String
  avis            Avis     @relation(fields: [avisId], references: [id], onDelete: Cascade)
  utilisateurId   String
  utilisateur     User     @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  raison          String
  description     String?
  dateSignalement DateTime @default(now())
  traite          Boolean  @default(false)

  @@unique([avisId, utilisateurId])
  @@map("avis_signalements")
}

model ContactMessage {
  id          String        @id @default(cuid())
  nom         String
  email       String
  sujet       String
  message     String
  statut      StatutMessage @default(non_lu)
  dateLecture DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  reponses ContactReponse[]

  @@index([createdAt])
  @@index([statut])
  @@map("contact_messages")
}

model ContactReponse {
  id        String         @id @default(cuid())
  messageId String
  message   ContactMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  corps     String
  auteur    String         @default("Admin")
  date      DateTime       @default(now())

  @@index([messageId])
  @@map("contact_reponses")
}

model PromoCode {
  id                        String    @id @default(cuid())
  code                      String    @unique
  description               String?
  typeRemise                String    @default("pourcentage") // pourcentage | fixe | livraison
  valeur                    Float     @default(0)
  montantMax                Float?
  montantMinimum            Float? // sous-total minimum du panier
  usageParClient            Int? // null = illimité
  premiereCommandeSeulement Boolean   @default(false)
  livraisonOfferte          Boolean   @default(false) // en plus de la remise : frais de livraison offerts
  clientId                  String? // code personnel : réservé à ce client
  sourceCommandeId          String?   @unique // commande qui a déclenché ce code (récompense)
  categories                String[]  @default([]) // vide = tout le catalogue
  actif                     Boolean   @default(true)
  dateDebut                 DateTime  @default(now())
  dateFin                   DateTime?
  utilisationsMax           Int?
  utilisations              Int       @default(0)
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  commandes Commande[]

  @@map("promo_codes")
}

model Setting {
  id        String   @id @default(cuid())
  cle       String   @unique
  valeur    Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("settings")
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("newsletter_subscribers")
}

model Favori {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platId    String
  plat      Plat     @relation(fields: [platId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, platId])
  @@index([userId, createdAt])
  @@map("favoris")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("push_subscriptions")
}

enum EspecesStatut {
  a_reverser
  reverse
}

/// Remise d'espèces d'un livreur à l'admin (confirmée par l'admin).
model ReversementEspeces {
  id         String    @id @default(cuid())
  livreurId  String
  livreur    User      @relation("ReversementsLivreur", fields: [livreurId], references: [id])
  adminId    String?
  admin      User?     @relation("ReversementsAdmin", fields: [adminId], references: [id])
  montant    Float
  note       String?
  /// en_attente (déclarée par le livreur) | valide (reçue par l'admin) | refuse
  statut     String    @default("valide")
  motifRefus String?
  annuleLe   DateTime?
  createdAt  DateTime  @default(now())

  commandes Commande[]
  journal   JournalCaisse[]

  @@index([livreurId, createdAt])
  @@map("reversements_especes")
}

/// Journal de caisse en ajout seul : jamais modifié, annulé par une écriture inverse.
model JournalCaisse {
  id            String              @id @default(cuid())
  type          String // encaissement | reversement | annulation_reversement
  montant       Float // encaissement > 0, reversement < 0, annulation > 0
  livreurId     String
  livreur       User                @relation("JournalLivreur", fields: [livreurId], references: [id])
  auteurId      String
  auteur        User                @relation("JournalAuteur", fields: [auteurId], references: [id])
  commandeId    String?
  commande      Commande?           @relation(fields: [commandeId], references: [id], onDelete: SetNull)
  reversementId String?
  reversement   ReversementEspeces? @relation(fields: [reversementId], references: [id], onDelete: SetNull)
  note          String?
  createdAt     DateTime            @default(now())

  @@index([livreurId, createdAt])
  @@index([createdAt])
  @@map("journal_caisse")
}

/// Preuve de virement (capture, relevé PDF) envoyée par le client, consultable par l'admin.
model JustificatifVirement {
  id          String    @id @default(cuid())
  commandeId  String
  commande    Commande  @relation(fields: [commandeId], references: [id], onDelete: Cascade)
  nom         String
  mime        String
  taille      Int
  donnees     Bytes
  /// en_attente | valide | refuse (décision de l'admin)
  statut      String    @default("en_attente")
  motifRefus  String?
  traiteLe    DateTime?
  traiteParId String?
  createdAt   DateTime  @default(now())

  @@index([commandeId])
  @@index([statut, createdAt])
  @@map("justificatifs_virement")
}

/// Session de travail d'un livreur (pointage début / fin).
model PointageLivreur {
  id           String       @id @default(cuid())
  livreurId    String
  livreur      User         @relation("PointagesLivreur", fields: [livreurId], references: [id])
  debut        DateTime
  fin          DateTime?
  /// Jour de rattachement (AAAA-MM-JJ, fuseau de Paris) : le jour du début de la session
  jour         String
  paieId       String?
  paie         PaieLivreur? @relation(fields: [paieId], references: [id], onDelete: SetNull)
  /// Heure de fin prévue choisie au pointage ; clôture automatique 30 min après si le livreur n'a pas terminé
  finPrevue    DateTime?
  clotureAuto  Boolean      @default(false)
  corrigeParId String?
  createdAt    DateTime     @default(now())

  @@index([livreurId, jour])
  @@index([paieId])
  @@map("pointages_livreur")
}

/// Paiement de la journée d'un livreur (heures pointées × taux horaire), figé au moment du paiement.
model PaieLivreur {
  id           String   @id @default(cuid())
  livreurId    String
  livreur      User     @relation("PaiesLivreur", fields: [livreurId], references: [id])
  adminId      String
  admin        User     @relation("PaiesAdmin", fields: [adminId], references: [id])
  jour         String
  minutes      Int
  tauxHoraire  Float
  montant      Float
  nbLivraisons Int      @default(0)
  prime        Float    @default(0)
  primeDetail  String?
  mode         String   @default("especes")
  note         String?
  createdAt    DateTime @default(now())

  ficheId String?
  fiche   FichePaie? @relation(fields: [ficheId], references: [id], onDelete: SetNull)

  pointages PointageLivreur[]

  @@index([livreurId, jour])
  @@index([ficheId])
  @@index([createdAt])
  @@map("paies_livreur")
}

/// Fiche de rémunération envoyée par l'admin au livreur : récapitulatif des journées payées sur une période.
model FichePaie {
  id           String    @id @default(cuid())
  numero       String    @unique
  livreurId    String
  livreur      User      @relation("FichesLivreur", fields: [livreurId], references: [id])
  adminId      String
  admin        User      @relation("FichesAdmin", fields: [adminId], references: [id])
  /// Période couverte (AAAA-MM-JJ)
  du           String
  au           String
  totalMinutes Int
  totalMontant Float
  nbLivraisons Int       @default(0)
  /// Version de la signature en vigueur à l'émission (null = signature par défaut)
  signatureId  String?
  envoyeLe     DateTime  @default(now())
  luLe         DateTime?

  paies PaieLivreur[]

  @@index([livreurId, envoyeLe])
  @@map("fiches_paie")
}

/// Mouvements du programme de fidélité (en ajout seul) : gains à la livraison, échanges contre un code promo.
model MouvementPoints {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta      Int
  motif      String
  commandeId String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@map("mouvements_points")
}

/// Panier partagé : plusieurs clients ajoutent des plats, l'hôte passe la commande.
model PanierGroupe {
  id        String   @id @default(cuid())
  code      String   @unique
  hoteId    String
  hote      User     @relation("GroupeHote", fields: [hoteId], references: [id], onDelete: Cascade)
  /// ouvert | commande | ferme
  statut    String   @default("ouvert")
  /// [{ participantId?, nom, platId, quantite, prixUnitaire, nomPlat }]
  articles  Json     @default("[]")
  commandeId String?
  expireLe  DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hoteId, statut])
  @@map("paniers_groupe")
}

/// Fil de discussion lié à une commande (client ↔ support / livreur).
model Conversation {
  id         String        @id @default(cuid())
  commandeId String        @unique
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  messages   MessageChat[]

  @@map("conversations")
}

model MessageChat {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  auteurId       String
  auteur         User         @relation(fields: [auteurId], references: [id], onDelete: Cascade)
  corps          String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@map("messages_chat")
}

/// Box / abonnement hebdomadaire de plats.
model Abonnement {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// hebdo | bihebdo
  frequence       String    @default("hebdo")
  /// nombre de plats par livraison
  tailleBox       Int       @default(4)
  /// ids de plats préférés / exclus
  preferences     Json      @default("{}")
  /// actif | pause | annule
  statut          String    @default("actif")
  prochainCreneau DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId, statut])
  @@map("abonnements")
}

/// Recette / histoire d'origine liée à un plat du catalogue.
model Recette {
  id          String   @id @default(cuid())
  platId      String?  @unique
  titre       String
  slug        String   @unique
  resume      String
  contenu     String
  paysOrigine String?
  dureeMin    Int?
  portions    Int?
  imageUrl    String?
  publie      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([publie, createdAt])
  @@map("recettes")
}

/// Alerte stock bas / rupture (générée automatiquement).
model AlerteStock {
  id          String    @id @default(cuid())
  platId      String
  /// bas | rupture
  type        String
  message     String
  quantite    Int?
  traitee     Boolean   @default(false)
  traiteeLe   DateTime?
  createdAt   DateTime  @default(now())

  @@index([traitee, createdAt])
  @@index([platId])
  @@map("alertes_stock")
}
