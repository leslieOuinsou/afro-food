# Copier en « .env » (jamais commité) et renseigner les valeurs.
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=change-moi-avec-un-mot-de-passe-long
JENKINS_URL=http://localhost:8080/
# Hébergement Oracle : nom de domaine public (ex. afro-ci.duckdns.org) servi en HTTPS par Caddy
JENKINS_DOMAIN=
VERCEL_TOKEN=
VERCEL_ORG_ID=team_wugMg3vhV9vBzCFaXS3aKrUA
VERCEL_BACKEND_PROJECT_ID=prj_O6Pz1Bbc1QVgNXOqfTvvTgFDwY0K
VERCEL_FRONTEND_PROJECT_ID=prj_gk8vB006dh7JdjpRtuFprIqaR9Pt
